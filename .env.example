# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# Cloudinary Configuration (Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Paystack Configuration (Payments - Ghana)
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# JWT Secret (Authentication)
JWT_SECRET=your_jwt_secret_here

# Session Secret
SESSION_SECRET=your_session_secret_here

# Frontend URL (for CORS - Netlify)
FRONTEND_URL=https://your-app.netlify.app

# Admin Accounts (Production)
# IMPORTANT: Set these for production deployments
# Development uses default credentials if not set
SUPER_ADMIN_EMAIL=superadmin@kiyumart.com
SUPER_ADMIN_PASSWORD=Smart@3990
ADMIN_EMAIL=admin@kiyumart.com
ADMIN_PASSWORD=AnotherStrongPasswordHere

# Node Environment
NODE_ENV=development
