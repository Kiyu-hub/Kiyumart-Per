      "PowerShell($c = Get-NetTCPConnection -LocalPort 5000 -State Listen -ErrorAction SilentlyContinue | Select-Object -First 1; if \\($c\\) { Stop-Process -Id $c.OwningProcess -Force; \"Killed PID \" + $c.OwningProcess } else { \"nothing on 5000\" })"
    ]
  }
}
